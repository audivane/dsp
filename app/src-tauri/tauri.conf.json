{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Audivane DSP",
  "mainBinaryName": "audivane-dsp-ui",
  "version": "0.11.0",
  "identifier": "com.audivane.dsp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1430",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "features": ["gui"]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Audivane DSP",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Audio",
    "shortDescription": "Control the Audivane DSP engine",
    "longDescription": "Upsampling, harmonics, parametric EQ, convolution, blind A/B tests and bit-perfect routing for the Audivane DSP engine.",
    "copyright": "Triet",
    "license": "AGPL-3.0-only",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
