# pacman scriptlets for the makepkg build. The release packages get the same
# logic from packaging/release/postinstall.sh; keep both in step.

# Reload every running user manager and restart audivane-dsp.service where it
# was running; prints the users it restarted. Best effort, never fails, and a
# no-op without systemd as init (containers, build roots).
_audivane_restart_user_engines() {
  [ -d /run/systemd/system ] || return 0
  command -v systemctl >/dev/null 2>&1 || return 0
  local t= dir uid user
  command -v timeout >/dev/null 2>&1 && t="timeout 30"
  for dir in /run/user/[0-9]*; do
    [ -S "$dir/systemd/private" ] || continue
    uid=${dir##*/}
    user=$(getent passwd "$uid" 2>/dev/null | cut -d: -f1)
    [ -n "$user" ] || continue
    $t systemctl --no-ask-password --user -M "$user@" daemon-reload >/dev/null 2>&1 || true
    if $t systemctl --no-ask-password --user -M "$user@" is-active --quiet audivane-dsp.service >/dev/null 2>&1; then
      if $t systemctl --no-ask-password --user -M "$user@" try-restart audivane-dsp.service >/dev/null 2>&1; then
        printf ' %s' "$user"
      fi
    fi
  done
  return 0
}

post_install() {
  cat <<'EOF'
==> audivane-dsp installed.

Start the DSP engine with your user session (the package never runs
systemctl for you):

    systemctl --user daemon-reload && systemctl --user enable --now audivane-dsp

Heads-up while the engine runs:
  * It registers itself as the PipeWire sink and takes your output DAC
    exclusively. Audio from other apps goes through Audivane; stop or
    disable the service to hand the device back.
  * Check it is alive and see its state with:  avdsp ctl status
  * The desktop app (Audivane DSP) talks to the same engine; it will show
    "engine is not running" until you start the service above.
EOF
}

post_upgrade() {
  local users
  users=$(_audivane_restart_user_engines 2>/dev/null) || users=
  if [ -n "$users" ]; then
    echo "==> audivane-dsp updated: restarted the engine for:$users"
  else
    echo "==> audivane-dsp updated. No running engine was restarted; start it with"
    echo "    systemctl --user daemon-reload && systemctl --user enable --now audivane-dsp"
  fi
  echo "    A running app restarts itself into the new version (if it cannot, it says so)."
  return 0
}

# Same as audivane_remove_everything in packaging/release/postinstall.sh.
pre_remove() {
  _t=
  command -v timeout >/dev/null 2>&1 && _t="timeout 30"
  if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
    for _dir in /run/user/[0-9]*; do
      [ -S "$_dir/systemd/private" ] || continue
      _user=$(getent passwd "${_dir##*/}" 2>/dev/null | cut -d: -f1)
      [ -n "$_user" ] || continue
      $_t systemctl --no-ask-password --user -M "$_user@" disable --now audivane-dsp.service >/dev/null 2>&1 || true
    done
  fi
  pkill -x audivane-dsp-ui >/dev/null 2>&1 || true
  pkill -x audivane-dsp >/dev/null 2>&1 || true
  getent passwd | while IFS=: read -r _user _x _uid _gid _gecos _home _shell; do
    [ "$_uid" -ge 1000 ] 2>/dev/null || continue
    [ -d "$_home" ] || continue
    rm -rf "$_home/.config/audivane-dsp" "$_home/.config/com.audivane.dsp" \
      "$_home/.local/share/com.audivane.dsp" "$_home/.cache/audivane-dsp" \
      "$_home/.local/state/audivane-dsp" "/run/user/$_uid/audivane-dsp" \
      "$_home/.config/autostart/audivane-dsp-ui.desktop"
    for _p in "$_home"/.config/audivane-dsp.backup-* "$_home"/.config/systemd/user/*.wants/audivane-dsp.service; do
      [ -e "$_p" ] || [ -L "$_p" ] || continue
      rm -rf "$_p"
    done
    # KDE: drop the app's (now inactive) global shortcuts.
    if [ -S "/run/user/$_uid/bus" ] && command -v gdbus >/dev/null 2>&1 && command -v runuser >/dev/null 2>&1; then
      DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$_uid/bus" $_t runuser -u "$_user" -- \
        gdbus call --session --dest org.kde.kglobalaccel --object-path /component/audivane_dsp_ui \
        --method org.kde.kglobalaccel.Component.cleanUp >/dev/null 2>&1 || true
    fi
  done
  echo "==> Audivane DSP removed: the engine and the app are stopped, and their settings deleted."
  return 0
}
