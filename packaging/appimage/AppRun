#!/bin/sh
# shellcheck shell=sh
#
# The Audivane DSP AppImage's entry point.
#
#   Audivane-DSP.AppImage                    open the app
#   Audivane-DSP.AppImage --install [--no-login-start]
#                                            install (or update) for this user
#   Audivane-DSP.AppImage --uninstall [--purge]
#   Audivane-DSP.AppImage --status
#   Audivane-DSP.AppImage avdsp <args>       the bundled CLI
#   Audivane-DSP.AppImage audivane-dsp <args>  the bundled engine
#
# Opening the app: with no user install, the app runs from the AppImage and
# offers the setup on its "engine is not running" page. With one, the
# installed app opens; when this AppImage is newer, it first updates the
# install (setup.sh install: new files, the service restarted, a running
# app relaunches itself). An older AppImage never downgrades by itself: it
# opens the installed app and says how to install this version instead.
set -eu

APPDIR=${APPDIR:-$(dirname "$(readlink -f "$0")")}
export APPDIR
SETUP=$APPDIR/usr/lib/audivane-dsp/setup.sh
LIB=$HOME/.local/lib/audivane-dsp

case ${1:-} in
  --install | --uninstall | --status)
    cmd=${1#--}; shift
    exec "$SETUP" "$cmd" "$@" ;;
  avdsp | audivane-dsp)
    b=$1; shift
    exec "$APPDIR/usr/bin/$b" "$@" ;;
  --help | -h)
    sed -n '4,19p' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
esac

this=$(cat "$APPDIR/usr/lib/audivane-dsp/VERSION")
installed=$(cat "$LIB/VERSION" 2>/dev/null || true)
# WebKitGTK comes from the host (see packaging/appimage/README.md): say so
# plainly instead of the loader's error.
check_libraries() {
  command -v ldd >/dev/null 2>&1 || return 0
  missing=$(ldd "$1" 2>/dev/null | sed -n 's/^[[:space:]]*\([^ ]*\) => not found.*/\1/p' | tr '\n' ' ')
  [ -z "$missing" ] && return 0
  msg="Audivane DSP needs WebKitGTK 4.1 and GTK 3 from your distribution (missing: $missing). Install webkit2gtk-4.1 (Debian/Ubuntu: libwebkit2gtk-4.1-0; Fedora: webkit2gtk4.1; Arch: webkit2gtk-4.1) and open it again. The engine and the avdsp CLI work without it."
  echo "error: $msg" >&2
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "Audivane DSP" "Audivane DSP cannot open" "$msg" 2>/dev/null || true
  fi
  exit 1
}

newest() { printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1; }

if [ -n "$installed" ] && [ -x "$LIB/audivane-dsp-ui" ]; then
  if [ "$installed" != "$this" ]; then
    if [ "$(newest "$this" "$installed")" = "$this" ]; then
      "$SETUP" install >&2 || echo "warning: updating the user install failed; opening $installed" >&2
    else
      echo "note: the installed Audivane DSP ($installed) is newer than this AppImage ($this); opening it." >&2
      echo "      To install $this instead: ${APPIMAGE:-$0} --install" >&2
    fi
  fi
  # The installed app is not the AppImage's: without these it would treat
  # itself as one (no self-relaunch after updates, autostart via the file).
  unset APPIMAGE APPDIR ARGV0 OWD APPIMAGE_EXTRACT_AND_RUN
  check_libraries "$LIB/audivane-dsp-ui"
  exec "$LIB/audivane-dsp-ui" "$@"
fi

check_libraries "$APPDIR/usr/bin/audivane-dsp-ui"
exec "$APPDIR/usr/bin/audivane-dsp-ui" "$@"
